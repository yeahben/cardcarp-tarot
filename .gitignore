# 1. Ignore everything in the project root and all subdirectories
/*

# 2. Allow the .gitignore file itself
!.gitignore
!.gitattributes

# 3. Allow all Python source files
!*.py
!*.yaml

# 4. Allow project metadata and setup files
!pyproject.toml
!requirements.txt
!README.md
!LICENSE.md
!CONTRIBUTING.md

# 5. Allow directories so Git can traverse into subfolders
!*/

# 6. Re-ignore standard Python build artifacts and cache folders
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.DS_Store

# 7. Card scans are large binaries published to the image CDN, not versioned here.
#    source/image mirrors data/card; see README.
source/
